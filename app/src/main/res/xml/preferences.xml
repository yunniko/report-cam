<?xml version="1.0" encoding="utf-8"?>
<!-- Keys and defaults mirror settings/AppSettings.kt (Keys). -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_stamp" app:iconSpaceReserved="false">
        <EditTextPreference
            app:key="stamp_text"
            app:iconSpaceReserved="false"
            app:title="@string/pref_stamp_text"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="show_datetime"
            app:title="@string/pref_show_datetime" />
        <ListPreference
            app:defaultValue="yyyy-MM-dd HH:mm:ss"
            app:dependency="show_datetime"
            app:entries="@array/datetime_pattern_labels"
            app:entryValues="@array/datetime_pattern_values"
            app:iconSpaceReserved="false"
            app:key="datetime_pattern"
            app:title="@string/pref_datetime_pattern"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:dependency="show_datetime"
            app:iconSpaceReserved="false"
            app:key="show_weekday"
            app:summary="@string/pref_show_weekday_summary"
            app:title="@string/pref_show_weekday" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="cat_location"
        app:title="@string/pref_cat_location">
        <Preference
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            app:key="location_permission"
            app:summary="@string/pref_location_denied_summary"
            app:title="@string/pref_location_denied" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="show_location"
            app:title="@string/pref_show_location" />
        <ListPreference
            app:defaultValue="decimal"
            app:dependency="show_location"
            app:entries="@array/coord_format_labels"
            app:entryValues="@array/coord_format_values"
            app:iconSpaceReserved="false"
            app:key="coord_format"
            app:title="@string/pref_coord_format"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="off"
            app:dependency="show_location"
            app:entries="@array/place_format_labels"
            app:entryValues="@array/place_format_values"
            app:iconSpaceReserved="false"
            app:key="place_format"
            app:summary="@string/pref_place_format_summary"
            app:title="@string/pref_place_format" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:dependency="show_location"
            app:iconSpaceReserved="false"
            app:key="show_coordinates"
            app:summary="@string/pref_show_coordinates_summary"
            app:title="@string/pref_show_coordinates" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:dependency="show_location"
            app:iconSpaceReserved="false"
            app:key="wait_precise"
            app:summary="@string/pref_wait_precise_summary"
            app:title="@string/pref_wait_precise" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_look" app:iconSpaceReserved="false">
        <ListPreference
            app:defaultValue="overlay_bottom_start"
            app:entries="@array/placement_labels"
            app:entryValues="@array/placement_values"
            app:iconSpaceReserved="false"
            app:key="placement"
            app:title="@string/pref_placement"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="medium"
            app:entries="@array/text_size_labels"
            app:entryValues="@array/text_size_values"
            app:iconSpaceReserved="false"
            app:key="text_size"
            app:title="@string/pref_text_size"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="dark"
            app:entries="@array/scheme_labels"
            app:entryValues="@array/scheme_values"
            app:iconSpaceReserved="false"
            app:key="stamp_scheme"
            app:title="@string/pref_scheme"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="medium"
            app:entries="@array/frame_border_labels"
            app:entryValues="@array/frame_border_values"
            app:iconSpaceReserved="false"
            app:key="frame_border"
            app:summary="@string/pref_frame_border_summary"
            app:title="@string/pref_frame_border" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_photo" app:iconSpaceReserved="false">
        <ListPreference
            app:defaultValue="1280"
            app:entries="@array/output_size_labels"
            app:entryValues="@array/output_size_values"
            app:iconSpaceReserved="false"
            app:key="output_size"
            app:title="@string/pref_output_size"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="full"
            app:entries="@array/aspect_labels"
            app:entryValues="@array/aspect_values"
            app:iconSpaceReserved="false"
            app:key="aspect_ratio"
            app:summary="@string/pref_aspect_summary"
            app:title="@string/pref_aspect" />
        <ListPreference
            app:defaultValue="0"
            app:entries="@array/default_ev_labels"
            app:entryValues="@array/default_ev_values"
            app:iconSpaceReserved="false"
            app:key="default_ev"
            app:summary="@string/pref_default_ev_summary"
            app:title="@string/pref_default_ev" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="save_gallery"
            app:summary="@string/pref_save_gallery_summary"
            app:title="@string/pref_save_gallery" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="caption"
            app:summary="@string/pref_caption_summary"
            app:title="@string/pref_caption" />
        <MultiSelectListPreference
            app:defaultValue="@array/quick_messenger_defaults"
            app:entries="@array/quick_messenger_labels"
            app:entryValues="@array/quick_messenger_values"
            app:iconSpaceReserved="false"
            app:key="quick_messengers"
            app:summary="@string/pref_quick_messengers_summary"
            app:title="@string/pref_quick_messengers" />
        <ListPreference
            app:defaultValue="start"
            app:entries="@array/quick_side_labels"
            app:entryValues="@array/quick_side_values"
            app:iconSpaceReserved="false"
            app:key="quick_side"
            app:summary="@string/pref_quick_side_summary"
            app:title="@string/pref_quick_side" />
    </PreferenceCategory>
</PreferenceScreen>
