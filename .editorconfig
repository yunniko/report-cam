# Copied from E:\CLAUDE\COMPANY\configs\kotlin.editorconfig — change it there, not here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
# Android resource IDs and test names do not follow Kotlin naming rules.
ktlint_standard_function-naming = disabled
