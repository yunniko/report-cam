<?xml version="1.0" encoding="utf-8"?>
<!-- White ring on a dark outline, so it shows on bright and dark scenes alike. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#66000000" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
