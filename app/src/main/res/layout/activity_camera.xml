<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <cz.julienika.reportcam.camera.CropGuideView
        android:id="@+id/crop_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/review_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/review_image"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <View
        android:id="@+id/focus_ring"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical|end"
        android:background="@drawable/top_scrim"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/location_marker"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/location_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location_on" />

            <TextView
                android:id="@+id/location_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="2"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                tools:text="8 m" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/exposure_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/exposure_label"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                tools:text="EV 0" />

            <SeekBar
                android:id="@+id/exposure"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/exposure" />

            <TextView
                android:id="@+id/zoom_label"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                tools:text="1.0x" />
        </LinearLayout>

        <Button
            android:id="@+id/shutter"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/shutter"
            android:contentDescription="@string/take_photo"
            android:enabled="false"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/review_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Shown while the photo waits for a precise fix (D008). -->
        <LinearLayout
            android:id="@+id/pending_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/pending_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- The rows below show once the photo is stamped (G-003 layout, Owner 2026-11-03). -->
        <LinearLayout
            android:id="@+id/scheme_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/stamp_scheme"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/scheme_dark"
                style="@style/SchemeButton"
                android:drawableStart="@drawable/ic_scheme_dark"
                android:text="@string/scheme_dark" />

            <Button
                android:id="@+id/scheme_light"
                style="@style/SchemeButton"
                android:drawableStart="@drawable/ic_scheme_light"
                android:text="@string/scheme_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/note_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <!-- One width for both switches, so the two rows line up. -->
            <Switch
                android:id="@+id/note_switch"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:switchPadding="8dp"
                android:text="@string/note_switch"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/note_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/note_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/message_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <!-- One width for both switches, so the two rows line up. -->
            <Switch
                android:id="@+id/message_switch"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:switchPadding="8dp"
                android:text="@string/message_switch"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/message_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/message_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Two or three quick messengers, evenly spaced (ShareButtons). -->
        <LinearLayout
            android:id="@+id/quick_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/quick_1"
                style="@style/ReviewButton" />

            <Button
                android:id="@+id/quick_2"
                style="@style/ReviewButton" />

            <Button
                android:id="@+id/quick_3"
                style="@style/ReviewButton" />
        </LinearLayout>

        <!-- Share, with a single quick messenger before or after it as an icon; Share takes the rest. -->
        <LinearLayout
            android:id="@+id/share_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/quick_start"
                style="@style/ReviewIconButton"
                android:visibility="gone" />

            <Button
                android:id="@+id/share_other"
                style="@style/ReviewButton"
                android:layout_weight="2"
                android:drawableStart="@drawable/ic_share"
                android:text="@string/share_other" />

            <ImageButton
                android:id="@+id/quick_end"
                style="@style/ReviewIconButton"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retake"
                style="@style/ReviewButton"
                android:drawableStart="@drawable/ic_retake"
                android:text="@string/retake" />

            <Button
                android:id="@+id/use_current"
                style="@style/ReviewButton"
                android:text="@string/use_current"
                android:visibility="gone" />

            <Button
                android:id="@+id/save_gallery"
                style="@style/ReviewButton"
                android:drawableStart="@drawable/ic_save"
                android:text="@string/save_gallery"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/busy"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/permission_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_needed"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant_permission" />
    </LinearLayout>
</FrameLayout>
